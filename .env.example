# --- Website (Next.js): copy to .env.local --------------------------------
# Public values only. The website reads with the anon key; RLS blocks writes.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# Optional: shows the "Free Hindi Quality Audit" button (mailto: link or form URL).
NEXT_PUBLIC_CONTACT_URL=

# --- Publishing scripts (Python): export these in your shell, do NOT put in .env.local ---
# Only scripts/publish_mvp.py --go needs them. Never expose the service-role key to the browser.
HF_TOKEN=            # only for gated base models (scripts/prepare_model.py)
HF_WRITE_TOKEN=      # Hugging Face token with write access
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=