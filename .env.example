# --- Website (Next.js): copy to .env.local, and set the same names in Vercel -------------------
# Public values only. The browser uses the anon key: it can read `models` and call 3 RPC functions.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
# mailto: link or WhatsApp/form URL. Used for "contact", the waitlist and delivery of calibrated files.
NEXT_PUBLIC_CONTACT_URL=
# Set to 1 only after db/schema_v3.sql is applied AND you are ready to run scripts/worker.py.
# Without it the home page shows no audit form.
NEXT_PUBLIC_AUDIT_ENABLED=
# Installer links for the Desk section. Leave empty until a real installer exists (no fake buttons).
NEXT_PUBLIC_DESK_WIN_URL=
NEXT_PUBLIC_DESK_MAC_URL=

# --- Python scripts: export these in your shell. NEVER put them in .env.local or in Vercel -----
HF_TOKEN=            # only for gated BASE models you convert yourself (scripts/prepare_model.py)
HF_WRITE_TOKEN=      # Hugging Face token with write access (scripts/publish_mvp.py)
SUPABASE_URL=https://xxxx.supabase.co
# Service-role key: full access. Used by publish_mvp.py, audit.py --upload, worker.py, admin.py.
SUPABASE_SERVICE_ROLE_KEY=
