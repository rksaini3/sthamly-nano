# Supabase configuration
# Replace placeholders on your own computer.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# NanoBrain model processing
HINDI_TEST_DATASET=./data/hindi-test.txt
SUPABASE_STORAGE_BUCKET=nanobrain-artifacts

# Local processing tools
HF_COMMAND=hf
LLAMA_CPP_CONVERTER=./llama.cpp/convert_hf_to_gguf.py
LLAMA_QUANTIZE=llama-quantize

# Local worker settings
NANOBRAIN_KEEP_FILES=false